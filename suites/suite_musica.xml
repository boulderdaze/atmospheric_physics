<?xml version="1.0" encoding="UTF-8"?>

<suite name="musica" version="1.0">
  <group name="physics_after_coupler">
    <scheme>calc_dry_air_ideal_gas_density</scheme>
    <!-- musica_ccpp handles the register/init/final phases shared by the
         photolysis and chemistry run schemes, and its timestep_init phase
         zeroes micm_rate_parameters each timestep. Schemes that provide
         additional rate parameters (e.g. heterogeneous or user-defined
         reaction rates) write only their own slots and may be placed
         anywhere before musica_ccpp_chemistry. -->
    <scheme>musica_ccpp</scheme>
    <scheme>musica_ccpp_photolysis</scheme>
    <scheme>musica_ccpp_chemistry</scheme>

    <!-- State diagnostics -->
    <scheme>sima_state_diagnostics</scheme>
  </group>
</suite>
